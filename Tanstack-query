10. Query Keys

Create a proper query-key factory:

export const userKeys = {
  all: ["users"] as const,

  lists: () =>
    [...userKeys.all, "list"] as const,

  list: (filters: UserFilters) =>
    [...userKeys.lists(), filters] as const,

  details: () =>
    [...userKeys.all, "detail"] as const,

  detail: (id: number) =>
    [...userKeys.details(), id] as const,
};

